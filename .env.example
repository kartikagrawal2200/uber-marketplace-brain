# Keys & Config — copy to .env and fill in values
# NEVER commit the real .env file

# --- Gemini API Keys (rotated round-robin) ---
GEMINI_KEY_1=your_gemini_api_key_1_here
GEMINI_KEY_2=your_gemini_api_key_2_here
GEMINI_KEY_3=your_gemini_api_key_3_here
GEMINI_KEY_4=your_gemini_api_key_4_here

# --- Local LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- App ---
APP_ENV=development
BACKEND_PORT=8000
TICK_INTERVAL_SECONDS=5
SIMULATION_SEED=42

# --- Database (optional SQLite for dev) ---
DATABASE_URL=sqlite:///./marketplace.db
