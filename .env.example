# Copy to .env (the launcher does this for you). NOTHING here is required: the app runs with no keys at all.
# All simulation data is SYNTHETIC.

# --- Optional: Gemini keys for nicer chat answers (leave empty to use the built-in templates) ---
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_MODEL=gemini-1.5-flash

# --- Optional: local LLM (Ollama). Not needed. ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Auth (demo only) ---
JWT_SECRET=change-me-for-anything-real
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- App ---
APP_ENV=development
BACKEND_PORT=8000
TICK_INTERVAL_SECONDS=1.0
SIMULATION_SEED=42
DATABASE_URL=sqlite+aiosqlite:///./marketplace.db
