# Keys & Config — copy to .env and fill in values

# --- Gemini API Keys (rotated round-robin across all 4 team members) ---
GEMINI_KEY_1=your_gemini_api_key_1_here
GEMINI_KEY_2=your_gemini_api_key_2_here
GEMINI_KEY_3=your_gemini_api_key_3_here
GEMINI_KEY_4=your_gemini_api_key_4_here

GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3,your_gemini_api_key_4
GEMINI_MODEL=gemini-1.5-flash

# --- Local LLM (Ollama) ---
# If Ollama is not installed or running, system automatically uses Gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=false

# --- Auth ---
JWT_SECRET=uber-marketplace-brain-secret-key-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- App ---
APP_ENV=development
BACKEND_PORT=8000
TICK_INTERVAL_SECONDS=1.0
SIMULATION_SEED=42

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./marketplace.db
